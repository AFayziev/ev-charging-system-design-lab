<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Reservation {{Action}}</title>
  <style>
    @media (max-width: 480px) {
      .email-content { padding: 24px 20px !important; }
      .email-title { font-size: 26px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f5f7f9; color:#273444; font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f7f9;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
          <tr>
            <td style="padding:0 8px 20px; color:#087f5b; font-size:20px; font-weight:700;">EV Charging</td>
          </tr>
          <tr>
            <td class="email-content" style="padding:32px; background-color:#ffffff; border:1px solid #dee2e6; border-radius:4px;">
              <span style="display:inline-block; padding:5px 10px; border-radius:4px; font-size:12px; font-weight:700; color:{{#if Cancelled}}#c92a2a{{else if Expired}}#495057{{else}}#087f5b{{/if}}; background-color:{{#if Cancelled}}#fff5f5{{else if Expired}}#f1f3f5{{else}}#e6fcf5{{/if}};">Reservation {{Action}}</span>
              <h1 class="email-title" style="margin:20px 0 12px; color:#101c3c; font-size:30px; line-height:1.25; font-weight:700;">Your reservation was {{Action}}.</h1>
              <p style="margin:0 0 28px; color:#59697a; font-size:14px; line-height:1.6;">Recorded at {{OccurredAt}} UTC</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #dee2e6;">
                <tr>
                  <td style="padding:20px 0 4px; color:#59697a; font-size:12px; font-weight:600;">STATION</td>
                </tr>
                <tr>
                  <td style="color:#101c3c; font-size:18px; line-height:1.5; font-weight:700; overflow-wrap:anywhere; word-break:break-word;">{{StationName}}</td>
                </tr>
                <tr>
                  <td style="padding:4px 0 12px; font-size:14px; line-height:1.6; overflow-wrap:anywhere; word-break:break-word;">{{StationAddress}}</td>
                </tr>
                <tr>
                  <td style="padding:0 0 20px; color:#59697a; font-size:14px; line-height:1.6; overflow-wrap:anywhere; word-break:break-word;">{{ChargerName}} &middot; Connector {{ConnectorNumber}}</td>
                </tr>
              </table>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f7f9; border-radius:4px;">
                <tr>
                  <td style="padding:16px 16px 6px; color:#59697a; font-size:12px; font-weight:600;">BOOKED START</td>
                </tr>
                <tr>
                  <td style="padding:0 16px 16px; font-size:14px; line-height:1.6;">{{StartsAt}} UTC</td>
                </tr>
                <tr>
                  <td style="padding:0 16px 6px; color:#59697a; font-size:12px; font-weight:600;">BOOKED END</td>
                </tr>
                <tr>
                  <td style="padding:0 16px 16px; font-size:14px; line-height:1.6;">{{EndsAt}} UTC</td>
                </tr>
              </table>
              <p style="margin:24px 0 6px; color:#59697a; font-size:12px; font-weight:600;">RESERVATION REFERENCE</p>
              <p style="margin:0; color:#59697a; font-size:12px; line-height:1.6; overflow-wrap:anywhere; word-break:break-all;">{{ReservationId}}</p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 8px 0; color:#59697a; font-size:12px; line-height:1.6;">EV Charging &middot; System design lab</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
