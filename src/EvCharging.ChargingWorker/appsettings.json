{
  "ChargingExecution": {
    "MaximumCommandRequests": 3,
    "MaximumConcurrentCommands": 4,
    "MaximumAutomaticStatusChecks": 6,
    "AutomaticStatusCheckInterval": "00:00:05",
    "ContinuedStatusCheckInterval": "00:00:30",
    "MaximumContinuedStatusCheckInterval": "00:15:00",
    "ContinuedStatusCheckSchedule": "*/30 * * * * *"
  },
  "MessagingFailures": {
    "TransientDatabaseRetryDelays": ["00:00:01", "00:00:05", "00:00:15"]
  },
  "ObservationProcessing": {
    "BatchSize": 500,
    "BatchWait": "00:00:00.200",
    "RetryDelay": "00:00:02",
    "MaximumRetryDelay": "00:00:30"
  },
  "ReservationExpiry": {
    "ScanSchedule": "*/30 * * * * *",
    "BatchSize": 100,
    "MaximumConcurrentChecks": 4
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "DisableHealthChecks": true,
          "Config": {
            "GroupId": "session-evidence",
            "AutoOffsetReset": "Earliest",
            "EnableAutoCommit": true,
            "EnableAutoOffsetStore": false
          }
        }
      }
    }
  }
}
