{
  "ObservationProcessing": {
    "BatchSize": 500,
    "BatchWait": "00:00:00.200",
    "RetryDelay": "00:00:02",
    "MaximumRetryDelay": "00:00:30"
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "DisableHealthChecks": true,
          "Config": {
            "GroupId": "observation-processing",
            "AutoOffsetReset": "Earliest",
            "EnableAutoCommit": true,
            "EnableAutoOffsetStore": false
          }
        }
      }
    }
  }
}
