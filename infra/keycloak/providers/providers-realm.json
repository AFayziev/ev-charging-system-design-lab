{
  "realm": "providers",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [{ "name": "charging-client" }, { "name": "simulation-admin" }]
  },
  "clientScopes": [
    {
      "name": "synchronous-provider",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "provider audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "synchronous-charging-provider",
            "access.token.claim": "true"
          }
        },
        {
          "name": "provider roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "role",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "charging-worker",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CHARGING_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["synchronous-provider"]
    },
    {
      "clientId": "simulation-control",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SIMULATION_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["synchronous-provider"]
    }
  ],
  "users": [
    {
      "username": "service-account-charging-worker",
      "enabled": true,
      "serviceAccountClientId": "charging-worker",
      "realmRoles": ["charging-client"]
    },
    {
      "username": "service-account-simulation-control",
      "enabled": true,
      "serviceAccountClientId": "simulation-control",
      "realmRoles": ["charging-client", "simulation-admin"]
    }
  ]
}
