<Project>
  <!-- Pinned Linux OCI images for baseline and optional lab profiles. -->
  <ItemGroup>
    <ContainerImage Include="Postgres" Image="docker.io/library/postgres" Tag="17.11-bookworm" />
    <ContainerImage Include="PgBouncer" Image="docker.io/edoburu/pgbouncer" Tag="v1.26.0-p0" />
    <ContainerImage Include="Keycloak" Image="quay.io/keycloak/keycloak" Tag="26.8.0" />
    <ContainerImage Include="MongoDB" Image="docker.io/library/mongo" Tag="8.3.11-noble" />
    <ContainerImage Include="Valkey" Image="docker.io/valkey/valkey" Tag="9.1.2" />
    <ContainerImage Include="Elasticsearch" Image="docker.elastic.co/elasticsearch/elasticsearch" Tag="9.5.4" />
    <ContainerImage Include="RabbitMQ" Image="docker.io/library/rabbitmq" Tag="4.3.6-management" />
    <ContainerImage Include="Kafka" Image="docker.io/apache/kafka" Tag="4.3.1" />
    <ContainerImage Include="RustFS" Image="docker.io/rustfs/rustfs" Tag="1.0.1" />
    <ContainerImage Include="OpenTelemetryCollector" Image="docker.io/otel/opentelemetry-collector-contrib" Tag="0.161.0" />
    <ContainerImage Include="Prometheus" Image="docker.io/prom/prometheus" Tag="v3.15.0" />
    <ContainerImage Include="Loki" Image="docker.io/grafana/loki" Tag="3.7.8" />
    <ContainerImage Include="Tempo" Image="docker.io/grafana/tempo" Tag="3.1.0" />
    <ContainerImage Include="Grafana" Image="docker.io/grafana/grafana" Tag="13.2.3" />
  </ItemGroup>
  <!-- Expose the manifest through normal SDK-generated assembly attributes. -->
  <ItemGroup>
    <AssemblyMetadata Include="@(ContainerImage->'ContainerImage.%(Identity).Image')" Value="%(Image)" />
    <AssemblyMetadata Include="@(ContainerImage->'ContainerImage.%(Identity).Tag')" Value="%(Tag)" />
  </ItemGroup>
</Project>
